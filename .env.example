# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
WORKERS=1
CORS_ORIGINS=["*"]

# Laya Model Settings
DEVICE=auto                     # "auto", "cuda", "cpu", "mps"
PRELOAD_ON_STARTUP=false        # Set to true for production low latency
MAX_LOADED_MODELS=2
# HF_TOKEN=your_huggingface_token_here

# Mock Mode (Set to true to test API without downloading model checkpoints)
MOCK_MODE=false

# Security (Optional API Key Protection)
API_KEY_ENABLED=false
# API_KEYS=["your-secret-api-key-1", "your-secret-api-key-2"]
